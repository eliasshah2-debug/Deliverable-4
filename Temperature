from __future__ import annotations

TOLERANCE = 1e-9
_VALID_UNITS = ("C", "F", "K")


def _to_kelvin(value: float, unit: str) -> float:
    """Gjør om en verdi i gitt enhet til Kelvin."""
    if unit == "K":
        return value
    if unit == "C":
        return value + 273.15
    return (value - 32) * 5 / 9 + 273.15  # "F"


class Temperature:
    """En temperatur i Celsius ("C"), Fahrenheit ("F") eller Kelvin ("K").
        
        Hvis enheten er ugyldig eller temperaturen er under absolutt null.
    """

    def __init__(self, value: float, unit: str = "C") -> None:
        if not isinstance(unit, str) or unit.upper() not in _VALID_UNITS:
            raise ValueError(
                f"Invalid unit {unit!r}; must be one of 'C', 'F' or 'K'."
            )
        unit = unit.upper()
        if _to_kelvin(value, unit) < -TOLERANCE:
            raise ValueError(
                f"Temperature {value} {unit} is below absolute zero."
            )
        self._value = float(value)
        self._unit = unit

    @property
    def value(self) -> float:
        return self._value

    @property
    def unit(self) -> str:
        return self._unit

    # konverteringer 
    def to_celsius(self) -> float:
        if self._unit == "C":
            return self._value
        if self._unit == "K":
            return self._value - 273.15
        return (self._value - 32) * 5 / 9

    def to_fahrenheit(self) -> float:
        if self._unit == "F":
            return self._value
        if self._unit == "C":
            return self._value * 9 / 5 + 32
        return (self._value - 273.15) * 9 / 5 + 32

    def to_kelvin(self) -> float:
        return _to_kelvin(self._value, self._unit)

    def convert_to(self, target_unit: str) -> Temperature:
        """Returnerer en ny Temperature-instans uttrykt i target_unit."""
        if not isinstance(target_unit, str) or target_unit.upper() not in _VALID_UNITS:
            raise ValueError(
                f"Invalid unit {target_unit!r}; must be one of 'C', 'F' or 'K'."
            )
        target = target_unit.upper()
        converters = {
            "C": self.to_celsius,
            "F": self.to_fahrenheit,
            "K": self.to_kelvin,
        }
        return Temperature(converters[target](), target)

    def __repr__(self) -> str:
        return f"Temperature({self._value!r}, {self._unit!r})"

    def __str__(self) -> str:
        if self._unit == "K":
            return f"{self._value:.2f} K"
        return f"{self._value:.2f} °{self._unit}"

    def _is_close(self, other: Temperature) -> bool:
        return abs(self.to_kelvin() - other.to_kelvin()) <= TOLERANCE

    def __eq__(self, other: object):
        if not isinstance(other, Temperature):
            return NotImplemented
        return self._is_close(other)

    def __ne__(self, other: object):
        if not isinstance(other, Temperature):
            return NotImplemented
        return not self._is_close(other)

    def __lt__(self, other: object):
        if not isinstance(other, Temperature):
            return NotImplemented
        return not self._is_close(other) and self.to_kelvin() < other.to_kelvin()

    def __le__(self, other: object):
        if not isinstance(other, Temperature):
            return NotImplemented
        return self._is_close(other) or self.to_kelvin() < other.to_kelvin()

    def __gt__(self, other: object):
        if not isinstance(other, Temperature):
            return NotImplemented
        return not self._is_close(other) and self.to_kelvin() > other.to_kelvin()

    def __ge__(self, other: object):
        if not isinstance(other, Temperature):
            return NotImplemented
        return self._is_close(other) or self.to_kelvin() > other.to_kelvin()

    __hash__ = None 
